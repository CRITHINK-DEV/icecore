  "filters": {
    "dbt_models": [
      "DBT_MODELS.PACKAGE_NAME <> 'elementary'"
    ],
    "dbt_run_results": [
      "DATEDIFF(DAY, CAST(DBT_RUN_RESULTS.EXECUTE_COMPLETED_AT AS TIMESTAMP), CAST(CURRENT_TIMESTAMP() AS TIMESTAMP)) < 7"
    ],
    "dbt_source_freshness_results": [
      "DATEDIFF(DAY, CAST(DBT_SOURCE_FRESHNESS_RESULTS.GENERATED_AT AS TIMESTAMP), CAST(CURRENT_TIMESTAMP() AS TIMESTAMP)) < 7"
    ],
    "dbt_tests": [
      "DBT_TESTS.TYPE = 'singular'"
    ],
    "elementary_test_results": [
      "DATEDIFF(DAY, CAST(ELEMENTARY_TEST_RESULTS.DETECTED_AT AS TIMESTAMP), CAST(CURRENT_TIMESTAMP() AS TIMESTAMP)) < 7"
    ],
    "model_run_results": [
      "DATEDIFF(DAY, CAST(MODEL_RUNS.GENERATED_AT AS TIMESTAMP), CAST(CURRENT_TIMESTAMP() AS TIMESTAMP)) < 7 AND NOT MODEL_RUNS.UNIQUE_ID LIKE 'model.elementary.%'"
    ],
    "test_result_rows": [
      "DATEDIFF(DAY, CAST(TEST_RESULT_ROWS.DETECTED_AT AS TIMESTAMP), CAST(CURRENT_TIMESTAMP() AS TIMESTAMP)) < 7 AND TEST_RESULT_ROWS.ELEMENTARY_TEST_RESULTS_ID IN (SELECT DISTINCT ORDERED_TEST_RESULTS__TMP_<ts>.ID AS ID FROM ICECORE_SANDBOX.<ELEMENTARY_SCHEMA>.ORDERED_TEST_RESULTS__TMP_<ts> AS ORDERED_TEST_RESULTS__TMP_<ts> WHERE ORDERED_TEST_RESULTS__TMP_<ts>.INVOCATIONS_RANK_INDEX = 1)"
    ]
  },
